# Copy this file to ".env" (same folder as compose.yaml) and fill it in. Never commit ".env".
# Use letters and digits only in POSTGRES_PASSWORD (it is placed inside a connection address).
# A good way to make one:  openssl rand -hex 24  (Windows PowerShell: see INSTALL.md)

POSTGRES_PASSWORD=
# At least 32 characters. Keep it secret and do not change it later, or unused sign-in codes stop working.
AUTH_SECRET=

# How email reaches people (sign-in codes, reminders). Microsoft 365 (see INSTALL.md, "Microsoft 365 email"):
# EMAIL_PROVIDER=m365
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# EMAIL_FROM=kainow@example.org
# ...or any SMTP server:
# SMTP_URL=smtp://user:password@mail.example.org:587
# SMTP_FROM=Kainow <no-reply@example.org>
# ...or, to try Kainow on your own computer only, print codes in the API log instead of emailing them.
# Kainow refuses this unless APP_URL is a localhost address, so it cannot be left on by mistake on a shared server.
# LOG_SIGN_IN_CODES=true

# There is no AI key here. AI keys are entered per project inside Kainow (Administrator > AI, then the project's AI tab)
# and stored encrypted with the protected key. The worker does not read OPENAI_API_KEY or ANTHROPIC_API_KEY.

# Optional. Change if port 3000 is taken. The page is then at http://localhost:<port>.
# KAINOW_PORT=3000
# Only if your browser refuses the sign-in cookie on plain http://localhost (Chrome and Edge accept it):
# COOKIE_SECURE=false
# The address people open Kainow at, used in invitation links. Defaults to http://localhost:<KAINOW_PORT>.
# Set it when others reach this computer by another name, e.g. https://kainow.example.org
# APP_URL=http://localhost:3000

# Production with AI: refuse to start unless the protected key loads (INSTALL.md, "Protected key").
# KAINOW_REQUIRE_PROTECTED_KEY=true
# Behind a reverse proxy: how many proxies append to X-Forwarded-For (usually 1). Leave unset when there is none,
# or every sign-in request appears to come from the proxy and shares one request limit.
# TRUST_PROXY=1
