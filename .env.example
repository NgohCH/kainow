# Copy this file to ".env" (same folder as compose.yaml) and fill it in. Never commit ".env".
# Use letters and digits only in POSTGRES_PASSWORD (it is placed inside a connection address).
# A good way to make one:  openssl rand -hex 24  (Windows PowerShell: see INSTALL.md)

POSTGRES_PASSWORD=
# At least 32 characters. Keep it secret and do not change it later, or unused sign-in codes stop working.
AUTH_SECRET=

# How sign-in codes reach people. Use email:
# SMTP_URL=smtp://user:password@mail.example.org:587
# SMTP_FROM=Kainow <no-reply@example.org>
# ...or, to try Kainow on your own computer only, print codes in the API log instead of emailing them:
LOG_SIGN_IN_CODES=true

# Lets the worker call the AI. Without it, extraction runs fail with a clear reason and nothing is sent or charged.
OPENAI_API_KEY=

# Optional. Change if port 3000 is taken. The page is then at http://localhost:<port>.
# KAINOW_PORT=3000
# Only if your browser refuses the sign-in cookie on plain http://localhost (Chrome and Edge accept it):
# COOKIE_SECURE=false
