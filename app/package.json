{
  "name": "kainow-app",
  "private": true,
  "version": "0.0.0",
  "description": "Kainow MVP application: NestJS API and pg-boss worker on PostgreSQL.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:web": "npm --prefix web run build",
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/db/migrate-cli.js",
    "create-admin": "node dist/users/create-admin-cli.js",
    "apply-mvp-spend-settings": "node dist/spend/apply-mvp-settings-cli.js",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "mammoth": "1.13.0",
    "multer": "2.1.1",
    "nodemailer": "10.3.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
