# Copy to .env for local use. Never commit real values.
DATABASE_URL=postgres://kainow:change-me@localhost:5432/kainow_dev
PORT=3000

# Random, at least 32 characters, for example: openssl rand -base64 48
AUTH_SECRET=

# How sign-in codes are delivered. Set SMTP_URL and SMTP_FROM to send them by email...
# SMTP_URL=smtp://user:password@mail.example.org:587
# SMTP_FROM=Kainow <no-reply@example.org>
# ...or, for local development only, print them in the server log:
# LOG_SIGN_IN_CODES=true

# Cookies are Secure by default. Uncomment only if your browser refuses them on http://localhost.
# COOKIE_SECURE=false

# Tests only: a throwaway database. The test suite DROPS and recreates its public schema.
# KAINOW_TEST_DATABASE_URL=postgres://kainow:change-me@localhost:5432/kainow_test

# Worker only: lets the worker call the AI. Never commit a real key. Without it, extraction runs fail
# with a clear reason and nothing is sent or charged.
# OPENAI_API_KEY=
