# Install settings: holds the database password, AUTH_SECRET and the AI key.
.env
# Backups made with the steps in INSTALL.md.
*.dump

# Protected key files (never commit)
secrets/
*.key

# Local Compose changes (INSTALL.md; compose.override.example.yaml shows the usual ones).
compose.override.yaml
# The installation's trusted release signers file (a copy of release/release-signers, INSTALL.md "Install").
/release-signers
# The previous trusted file, kept by the updater while an update is installed (10b spec 5.6).
/release-signers.previous
/release-signers.tmp
/release-signers.previous.tmp
# The updater's staging checkouts (10b spec 5.4).
.kainow-staging/
